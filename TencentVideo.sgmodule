#!name=腾讯视频净化 (Surge)
#!desc=基于 xingjiu29/txvideo Loon 插件移植，去除腾讯视频开屏、视频前贴片等广告并精简部分标签和个人页。兼容性视腾讯视频版本而定。
#!author=ZenmoFeiShi（原作者） / xingjiu29（Loon 版本） / Surge 适配
#!homepage=https://github.com/xingjiu29/txvideo
#!update=2026-10-31
#!system=ios

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
腾讯视频-请求 = type=http-request, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=20, script-path=https://raw.githubusercontent.com/SoWaahy/surge-modules/main/Txvideoad-Surge.js
腾讯视频-响应 = type=http-response, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=20, script-path=https://raw.githubusercontent.com/SoWaahy/surge-modules/main/Txvideoad-Surge.js
腾讯视频-JCE = type=http-response, pattern=^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=20, script-path=https://raw.githubusercontent.com/SoWaahy/surge-modules/main/Txvideoad-Surge.js
腾讯视频-Tab = type=http-response, pattern=^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=20, script-path=https://raw.githubusercontent.com/SoWaahy/surge-modules/main/Txvideoad-Surge.js
腾讯视频-配置 = type=http-response, pattern=^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$, requires-body=true, timeout=20, script-path=https://raw.githubusercontent.com/SoWaahy/surge-modules/main/Txvideoad-Surge.js

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
